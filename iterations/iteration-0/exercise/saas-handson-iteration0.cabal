cabal-version:      2.4
name:               saas-handson-iteration0
version:            0.1.0.0
synopsis:           HaskellとServantで作るtoB SaaSハンズオン教材（Iteration 0・演習用）
build-type:         Simple

library
    hs-source-dirs:   src
    exposed-modules:  Api
                    , Server
                    , Types
    build-depends:    base >=4.14 && <5
                    , servant
                    , servant-server
                    , warp
                    , aeson
                    , text
                    , wai
    default-language: Haskell2010

executable saas-handson-iteration0
    hs-source-dirs:   app
    main-is:          Main.hs
    ghc-options:      -threaded
    build-depends:    base >=4.14 && <5
                    , saas-handson-iteration0
                    , warp
    default-language: Haskell2010

-- 単体テスト：ハンドラの戻り値を直接検証する（実DB・外部サービスに
-- 一切依存しない）。学習者が test/unit/HealthSpec.hs を作成したら、
-- 下のother-modulesにHealthSpecを追記すること。
test-suite unit
    type:               exitcode-stdio-1.0
    hs-source-dirs:     test/unit
    main-is:            Spec.hs
    build-depends:      base >=4.14 && <5
                      , saas-handson-iteration0
                      , hspec
                      , servant-server
                      , aeson
                      , text
    build-tool-depends: hspec-discover:hspec-discover
    default-language:   Haskell2010

-- 結合テスト：WAI Application相手にHTTPリクエストを発行して検証する。
-- 学習者が test/integration/HealthSpec.hs を作成したら、下の
-- other-modulesにHealthSpecを追記すること。
test-suite integration
    type:               exitcode-stdio-1.0
    hs-source-dirs:     test/integration
    main-is:            Spec.hs
    build-depends:      base >=4.14 && <5
                      , saas-handson-iteration0
                      , hspec
                      , hspec-wai
                      , hspec-wai-json
                      , servant-server
                      , wai
                      , aeson
    build-tool-depends: hspec-discover:hspec-discover
    default-language:   Haskell2010

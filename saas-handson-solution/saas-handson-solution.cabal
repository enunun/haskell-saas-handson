cabal-version:      2.4
name:               saas-handson-solution
version:            0.1.0.0
synopsis:           HaskellとServantで作るtoB SaaSハンズオン教材の解答例
build-type:         Simple

library
    hs-source-dirs:   src
    exposed-modules:  Api
                    , Server
                    , Auth.Server
                    , Auth.Types
                    , Health.Api
                    , Health.Server
                    , Health.Types
                    , User.Api
                    , User.Server
                    , User.Types
                    , User.Error
                    , User.Repository
                    , User.Repository.InMemory
                    , User.Repository.Postgres
    build-depends:    base >=4.14 && <5
                    , servant
                    , servant-server
                    , warp
                    , aeson
                    , text
                    , bytestring
                    , wai
                    , jose
                    , lens
                    , mtl
                    , http-conduit
                    , containers
                    , postgresql-simple
                    , resource-pool
                    , http-types
    default-language: Haskell2010

executable saas-handson-solution
    hs-source-dirs:   app
    main-is:          Main.hs
    ghc-options:      -threaded
    build-depends:    base >=4.14 && <5
                    , saas-handson-solution
                    , warp
                    , bytestring
    default-language: Haskell2010

-- 単体テストはUser.Repository.InMemoryのみを使い、実DB（PostgreSQL）へ
-- は一切接続しない。dockerを起動していない環境でも常にGREEN/RED判定が
-- 高速かつ確定的に行えることを保証するための意図的な制約。
test-suite unit
    type:               exitcode-stdio-1.0
    hs-source-dirs:     test/unit
    main-is:            Spec.hs
    other-modules:      Auth.AuthSpec
                    , Health.HealthSpec
                    , User.UserSpec
                    , User.RepositorySpec
    build-depends:      base >=4.14 && <5
                      , saas-handson-solution
                      , hspec
                      , servant-server
                      , jose
                      , lens
                      , mtl
                      , text
                      , time
                      , bytestring
                      , aeson
    build-tool-depends: hspec-discover:hspec-discover
    default-language:   Haskell2010

-- 結合テストはUser.Repository.Postgres（実DB）を使う。実行には
-- devcontainerのdocker composeで一緒に起動するdbサービスが必要
-- （docs/iteration-4.mdを参照）。
test-suite integration
    type:               exitcode-stdio-1.0
    hs-source-dirs:     test/integration
    main-is:            Spec.hs
    other-modules:      Health.HealthSpec
                    , User.UserSpec
                    , User.RepositorySpec
    build-depends:      base >=4.14 && <5
                      , saas-handson-solution
                      , hspec
                      , hspec-wai
                      , hspec-wai-json
                      , servant-server
                      , wai
                      , aeson
                      , bytestring
                      , jose
                      , lens
                      , mtl
                      , text
                      , time
                      , http-types
                      , postgresql-simple
                      , resource-pool
    build-tool-depends: hspec-discover:hspec-discover
    default-language:   Haskell2010
